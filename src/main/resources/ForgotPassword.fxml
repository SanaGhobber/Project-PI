<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.controllers.ForgotPasswordController">
    <!-- Header -->
    <top>
        <HBox style="-fx-background-color: #2c3e50; -fx-padding: 15;" alignment="CENTER_LEFT" spacing="20">
            <Label text="MySportApp" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Button text="Produit" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
            <Button text="Évènement" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
            <Button text="Contact" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 40; -fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5;">
            <Label text="Mot de passe oublié" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
            <Label text="Veuillez saisir votre adresse email pour réinitialiser votre mot de passe." wrapText="true" style="-fx-text-fill: #555;"/>
            <TextField fx:id="emailField" promptText="Adresse email" prefHeight="35"/>
            <Button fx:id="resetButton" text="Réinitialiser le mot de passe" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 10 20; -fx-background-radius: 5;"/>
        </VBox>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox style="-fx-background-color: #2c3e50; -fx-padding: 15;" alignment="CENTER" spacing="10">
            <Label text="© 2023 MySportApp" style="-fx-text-fill: white;"/>
            <Hyperlink text="Mentions légales" style="-fx-text-fill: white;"/>
            <Hyperlink text="Contact" style="-fx-text-fill: white;"/>
        </HBox>
    </bottom>
</BorderPane>

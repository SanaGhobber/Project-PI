<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.controllers.AjoutEvenement">
   <children>
      <Label layoutX="150.0" layoutY="150.0" text="Lieu" />
      <TextField fx:id="lieu" layoutX="300.0" layoutY="145.0" />

      <Label layoutX="150.0" layoutY="190.0" text="Capacité Max" />
      <TextField fx:id="capaciteMax" layoutX="300.0" layoutY="185.0" />

      <Label layoutX="150.0" layoutY="230.0" text="Sport" />
      <TextField fx:id="sport" layoutX="300.0" layoutY="225.0" />

      <Button fx:id="addButton" layoutX="450.0" layoutY="420.0" mnemonicParsing="false" onAction="#handleAddButton" text="Add" />


   </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.controllers.AjoutPersonne">
    <!-- Simple Header -->
    <top>
        <HBox style="-fx-background-color: #2c3e50; -fx-padding: 15;" alignment="CENTER_LEFT" spacing="20">
            <Label text="MySportApp" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Button text="Produit" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
            <Button text="Évènement" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
            <Button text="Contact" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 40; -fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5;">
            <Label text="Créer votre compte" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
            <GridPane hgap="15" vgap="15">
                <columnConstraints>
                    <ColumnConstraints percentWidth="40"/>
                    <ColumnConstraints percentWidth="60"/>
                </columnConstraints>

                <children>
                    <Label text="Prénom*" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #555;"/>
                    <TextField fx:id="prenom" GridPane.rowIndex="0" GridPane.columnIndex="1" prefHeight="35"/>

                    <Label text="Nom*" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #555;"/>
                    <TextField fx:id="nom" GridPane.rowIndex="1" GridPane.columnIndex="1" prefHeight="35"/>

                    <Label text="Email*" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-text-fill: #555;"/>
                    <TextField fx:id="email" GridPane.rowIndex="2" GridPane.columnIndex="1" prefHeight="35"/>

                    <Label text="Mot de passe*" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-text-fill: #555;"/>
                    <PasswordField fx:id="password" GridPane.rowIndex="3" GridPane.columnIndex="1" prefHeight="35"/>

                    <Label text="Rôle*" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-text-fill: #555;"/>
                    <ComboBox fx:id="role" GridPane.rowIndex="4" GridPane.columnIndex="1" prefHeight="35"/>
                </children>
            </GridPane>

            <Button fx:id="addButton" text="Créer un compte" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 10 20; -fx-background-radius: 5;"/>
            <Hyperlink fx:id="loginLink" text="Vous avez déjà un compte ? Connectez-vous !" style="-fx-text-fill: #2980b9;"/>
        </VBox>
    </center>

    <!-- Simple Footer -->
    <bottom>
        <HBox style="-fx-background-color: #2c3e50; -fx-padding: 15;" alignment="CENTER" spacing="10">
            <Label text="© 2023 MySportApp" style="-fx-text-fill: white;"/>
            <Hyperlink text="Mentions légales" style="-fx-text-fill: white;"/>
            <Hyperlink text="Contact" style="-fx-text-fill: white;"/>
        </HBox>
    </bottom>
</BorderPane>